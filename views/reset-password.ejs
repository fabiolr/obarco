<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>O Barco - Reset Password</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="auth-container">
        <div class="auth-form">
            <div class="auth-header">
                <span class="logo-icon">⚓</span>
                <h1>O Barco</h1>
                <p>Enter your new password</p>
            </div>

            <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
                <div class="errors">
                    <ul>
                        <% errors.forEach(error => { %>
                            <li><%= error.msg %></li>
                        <% }); %>
                    </ul>
                </div>
            <% } %>

            <% if (typeof token !== 'undefined' && token) { %>
                <form method="POST">
                    <div class="form-group">
                        <label for="password">New Password</label>
                        <input type="password" id="password" name="password" required minlength="6">
                        <small style="color: #666;">Password must be at least 6 characters</small>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">Confirm New Password</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6">
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-primary btn-full">Reset Password</button>
                    </div>
                </form>
            <% } else { %>
                <div class="auth-link">
                    <p><a href="/forgot-password">Request a new reset link</a></p>
                </div>
            <% } %>

            <div class="auth-link">
                <p>Remember your password? <a href="/login">Login here</a></p>
            </div>
        </div>
    </div>
</body>
</html>
