<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>O Barco - Forgot Password</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="auth-container">
        <div class="auth-form">
            <div class="auth-header">
                <span class="logo-icon">⚓</span>
                <h1>O Barco</h1>
                <p>Reset your password</p>
            </div>

            <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
                <div class="errors">
                    <ul>
                        <% errors.forEach(error => { %>
                            <li><%= error.msg %></li>
                        <% }); %>
                    </ul>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="success">
                    <p><%= success %></p>
                    <% if (typeof resetLink !== 'undefined' && resetLink) { %>
                        <div style="margin-top: 20px; padding: 15px; background: #f5f5f5; border-radius: 4px; word-break: break-all;">
                            <strong>Reset Link:</strong><br>
                            <a href="<%= resetLink %>" style="color: #2563eb;"><%= resetLink %></a>
                        </div>
                        <% if (typeof phone !== 'undefined' && phone) { %>
                            <p style="margin-top: 15px; font-size: 14px; color: #666;">
                                Share this link with the user at phone: <strong><%= phone %></strong>
                            </p>
                        <% } %>
                    <% } %>
                </div>
            <% } else { %>
                <form method="POST">
                    <div class="form-group">
                        <label for="username">Username</label>
                        <input type="text" id="username" name="username" required>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-primary btn-full">Request Reset Link</button>
                    </div>
                </form>
            <% } %>

            <div class="auth-link">
                <p>Remember your password? <a href="/login">Login here</a></p>
            </div>
        </div>
    </div>
</body>
</html>
