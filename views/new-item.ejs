<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>O Barco - New Item</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="header">
        <div class="logo">
            <a href="/">
                <span class="logo-icon">⚓</span>
                <span class="logo-text">O Barco</span>
            </a>
        </div>
        <div class="header-actions">
            <form action="/logout" method="POST" style="display: inline;">
                <button type="submit" class="btn-logout">Logout</button>
            </form>
        </div>
    </header>

    <div class="container">
        <div class="card">
            <h2>Create New Item</h2>
            
            <form action="/items" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="title">Title *</label>
                    <input type="text" id="title" name="title" required>
                </div>
                
                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="description" rows="4"></textarea>
                </div>

                <div class="form-group">
                    <label for="attachments">Attachments</label>
                    <div class="file-upload-area">
                        <input type="file" id="attachments" name="attachments" multiple accept="image/*,.pdf,.doc,.docx,.txt,.csv,.xlsx,.xls">
                        <div class="file-upload-hint">
                            <span class="upload-icon">📎</span>
                            <p>Click to select files or drag and drop</p>
                            <small>Supported: Images, PDFs, Documents (Max 50MB each, up to 5 files)</small>
                        </div>
                        <div id="file-list" class="file-list"></div>
                    </div>
                </div>
                
                <div class="form-actions">
                    <button type="submit" class="btn-primary btn-create">Create Item</button>
                    <a href="/" class="btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        // File upload preview functionality with image compression
        document.getElementById('attachments').addEventListener('change', function(e) {
            const fileList = document.getElementById('file-list');
            const files = Array.from(e.target.files);
            
            fileList.innerHTML = '';
            
            if (files.length > 0) {
                files.forEach((file, index) => {
                    const fileItem = document.createElement('div');
                    fileItem.className = 'file-item';
                    
                    const fileName = file.name.length > 30 ? 
                        file.name.substring(0, 30) + '...' : file.name;
                    
                    const fileSize = (file.size / 1024 / 1024).toFixed(2);
                    
                    // Show warning for large files
                    const sizeWarning = file.size > 20 * 1024 * 1024 ? 
                        '<small style="color: #e67e22;">⚠️ Large file - may take time to upload</small>' : '';
                    
                    fileItem.innerHTML = `
                        <span class="file-icon">📄</span>
                        <div class="file-info">
                            <div class="file-name">${fileName}</div>
                            <div class="file-size">${fileSize} MB</div>
                            ${sizeWarning}
                        </div>
                        <button type="button" class="btn-remove-file" onclick="removeFile(${index})">×</button>
                    `;
                    
                    fileList.appendChild(fileItem);
                });
            }
        });

        function removeFile(index) {
            const input = document.getElementById('attachments');
            const dt = new DataTransfer();
            const files = Array.from(input.files);
            
            files.forEach((file, i) => {
                if (i !== index) {
                    dt.items.add(file);
                }
            });
            
            input.files = dt.files;
            
            // Trigger change event to update the preview
            input.dispatchEvent(new Event('change', { bubbles: true }));
        }

        // Drag and drop functionality
        const uploadArea = document.querySelector('.file-upload-area');
        
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            uploadArea.addEventListener(eventName, preventDefaults, false);
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        ['dragenter', 'dragover'].forEach(eventName => {
            uploadArea.addEventListener(eventName, highlight, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            uploadArea.addEventListener(eventName, unhighlight, false);
        });

        function highlight(e) {
            uploadArea.classList.add('drag-over');
        }

        function unhighlight(e) {
            uploadArea.classList.remove('drag-over');
        }

        uploadArea.addEventListener('drop', handleDrop, false);

        function handleDrop(e) {
            const dt = e.dataTransfer;
            const files = dt.files;
            
            document.getElementById('attachments').files = files;
            document.getElementById('attachments').dispatchEvent(new Event('change', { bubbles: true }));
        }

        // Click to upload
        uploadArea.addEventListener('click', function() {
            document.getElementById('attachments').click();
        });
    </script>
</body>
</html>